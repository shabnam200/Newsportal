APP_NAME="Phoenix Project Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---- MAIN database (signup data, packages, billing, admin) ----
# Use the database imported from sample.sql, then import database/main/main_db_additions.sql into it.
# Never run `php artisan migrate` (see database/main/README.md).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sample
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ---- Tenant database server (value will be provided by supervisor) ----
# The user needs CREATE / DROP DATABASE privilege.
TENANT_DB_DRIVER=mysql
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=3306
TENANT_DB_USERNAME=root
TENANT_DB_PASSWORD=
TENANT_DB_PREFIX=tenant_
TENANT_IMPORT_SAMPLE_DATA=false
# Give every environment (your PC, staging, production) its own prefix. Two installations that
# share one MySQL server and the same prefix would both claim tenant_1, tenant_2, ...
# The user also needs CREATE VIEW privilege.
TENANT_DEFAULT_TIMEZONE=Asia/Dhaka
# TENANT_INSTALLATION_ID=            # optional, defaults to a hash of APP_KEY
# PORTAL_MOBILE_REGEX=               # optional, defaults to Bangladeshi mobile numbers

# ---- Production: APP_ENV=production, APP_DEBUG=false, a dedicated DB user instead of root ----

APP_TIMEZONE=Asia/Dhaka
